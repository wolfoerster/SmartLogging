<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net48</TargetFrameworks>
    <LangVersion>latestMajor</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <Title>SmartLogging</Title>
    <PackageId>SmartLogging</PackageId>
    <Version>4.0.0</Version>
    <PackageVersion>4.0.0</PackageVersion>
    <Authors>Wolfgang Foerster</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wolfoerster/SmartLogging</RepositoryUrl>
    <PackageProjectUrl>https://github.com/wolfoerster/SmartLogging</PackageProjectUrl>
    <Description>Easy to use .NET logging framework using JSON as output format</Description>
    <PackageReleaseNotes>Replaced LogEntry.Annex by LogEntry.ThreadId -- Changed semantic of LogLevel.None -- Added context specific MinimumLogLevels -- Added SmartLogger.Exception() -- Removed SmartLogger.None()</PackageReleaseNotes>
    <Copyright>Copyright © 2017 - 2026 Wolfgang Foerster (wolfoerster@gmx.de)</Copyright>
    <PackageTags>Logging;.NET;JSON</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove=".gitattributes" />
    <None Remove=".gitignore" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
